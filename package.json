{
  "name": "hoodrun_axelar_checker",
  "version": "1.0.0",
  "description": "This module provides a Axelar Network Validator Statistics checking mechanism periodically",
  "scripts": {
    "test": "NODE_ENV=test jest",
    "test:query": "jest src/tests/services/amplifier/AmplifierQueryService.test.ts",
    "test:repository": "jest src/tests/database/repositories/amplifier/AmplifierRepositories.test.ts",
    "test:handler": "jest src/tests/ws/handlers/AmplifierEventHandler.test.ts",
    "test:client": "jest src/tests/ws/client/AxelarWsClient.test.ts",
    "test:job": "jest src/tests/queue/jobs/amplifier/PollTrackingJob.test.ts && jest src/tests/queue/jobs/amplifier/SignatureTrackingJob.test.ts",
    "test:queue": "jest src/tests/queue/AmplifierQueueManager.test.ts",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "NODE_ENV=development nodemon",
    "start": "pnpm run build && npx cross-env NODE_ENV=production node dist/src/index.js",
    "start:dev": "pnpm run build && npx cross-env NODE_ENV=development node dist/src/index.js",
    "build": "swc src -d dist --source-maps --copy-files",
    "test:real": "NODE_ENV=test REAL_DB=true jest src/tests/database/repositories/amplifier/AmplifierRepositories.test.ts",
    "test:integration": "NODE_ENV=test jest --config jest.config.ts --testMatch '**/tests/integration/**/*.test.ts' --runInBand"
  },
  "author": "Amorf",
  "license": "ISC",
  "dependencies": {
    "@cosmjs/crypto": "^0.32.2",
    "@cosmjs/encoding": "^0.32.2",
    "@golevelup/ts-jest": "^0.6.1",
    "axios": "^1.6.5",
    "axios-retry": "^4.0.0",
    "bignumber.js": "^9.1.2",
    "bull": "^4.12.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "grammy": "^1.20.1",
    "jest-mock-extended": "^4.0.0-beta1",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.1.1",
    "node-schedule": "^2.1.1",
    "nodemon": "^3.0.2",
    "pnpm": "^9.1.4",
    "redis": "^4.6.13",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@swc/cli": "^0.3.9",
    "@swc/core": "^1.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "^29.5.14",
    "@types/node-fetch": "^2.6.10",
    "@types/ws": "^8.5.10",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "tslint": "^6.1.3",
    "typescript": "^5.3.3"
  }
}
